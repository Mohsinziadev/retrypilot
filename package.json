{
  "name": "retrypilot",
  "version": "0.1.0",
  "description": "Safe, predictable, observable retry policies for async operations and fetch: idempotency guards, deadlines, retry budgets, Retry-After support.",
  "keywords": [
    "retry",
    "backoff",
    "jitter",
    "fetch",
    "idempotency",
    "retry-budget",
    "deadline",
    "abortsignal",
    "resilience"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deno": "npm run build && deno run --allow-read scripts/deno-smoke.mjs",
    "inspect": "publint && attw --pack . --profile esm-only && npm pack --dry-run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:deno && npm run inspect",
    "prepublishOnly": "npm run check",
    "dev:site": "vite --config demo/vite.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "typecheck:site": "tsc --noEmit -p demo/tsconfig.json"
  },
  "author": "Mohsin Zia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohsinziadev/retrypilot.git"
  },
  "bugs": {
    "url": "https://github.com/Mohsinziadev/retrypilot/issues"
  },
  "homepage": "https://www.m2toolkit.com/npm-packages/retrypilot",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "marked": "^18.1.2",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
