{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "retrypilot": ["../src/index.ts"],
      "retrypilot/http": ["../src/http.ts"],
      "retrypilot/node": ["../src/node.ts"],
      "retrypilot/testing": ["../src/testing.ts"]
    }
  },
  "include": ["src", "snippets", "entry-server.tsx", "vite.config.ts", "content-plugin.ts"]
}
